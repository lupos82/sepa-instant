# .htaccess para /tools (Apache, hosting DonDominio). Copiar como <salida>/tools/.htaccess.
# Si el hosting no permite alguna directiva, Apache devolverá error 500: comentar la línea afectada.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /tools/404.html

<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/xml .xml
  AddCharset utf-8 .html .json .js .css .xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Ajustar si la web corporativa inyecta scripts de terceros en /tools (EXTRA_HEAD_FILE).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://cryptopocket.io; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  # HTML: revalidar siempre (los datos cambian a diario como mucho).
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # CSS/JS versionados con ?v=<hash>: caché larga.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Datos: 1 hora.
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Las barras finales son las URL canónicas.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ %{REQUEST_URI}/ [R=301,L]
</IfModule>
